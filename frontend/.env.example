# Desarrollo (recomendado): no definas VITE_API_URL.
# El front llama a /api y Vite reenvía a VITE_PROXY_TARGET (por defecto http://127.0.0.1:5000).
# Así evitás CORS y "Network Error" si el backend está en otro puerto distinto al del .env viejo.

# URL explícita del API (solo si no querés usar el proxy, p. ej. probando otro host).
# VITE_API_URL=http://127.0.0.1:5000/api

# A dónde apunta el proxy de Vite en desarrollo (backend Express).
# VITE_PROXY_TARGET=http://127.0.0.1:5000

# Producción / preview: obligatorio apuntar al API público.
# VITE_API_URL=https://tu-dominio-api.com/api
