NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/ecommerce_db
JWT_SECRET=super_secret_jwt_key
# En desarrollo, localhost con cualquier puerto (p. ej. Vite 5173–5176) queda permitido si NODE_ENV !== production.
# En producción, listá aquí solo los orígenes reales del frontend.
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175,https://tu-frontend.vercel.app
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret

MERCADOPAGO_ACCESS_TOKEN=tu_access_token
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000
